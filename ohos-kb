set -euo pipefail

_OKCP_LIB_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/scripts/lib
# shellcheck source=scripts/lib/common.sh
source "${_OKCP_LIB_DIR}/common.sh"
# shellcheck source=scripts/lib/matrix.sh
source "${_OKCP_LIB_DIR}/matrix.sh"
# shellcheck source=scripts/lib/fetch.sh
source "${_OKCP_LIB_DIR}/fetch.sh"
# shellcheck source=scripts/lib/patch.sh
source "${_OKCP_LIB_DIR}/patch.sh"
# shellcheck source=scripts/lib/config.sh
source "${_OKCP_LIB_DIR}/config.sh"
# shellcheck source=scripts/lib/toolchain.sh
source "${_OKCP_LIB_DIR}/toolchain.sh"
# shellcheck source=scripts/lib/build.sh
source "${_OKCP_LIB_DIR}/build.sh"
# shellcheck source=scripts/lib/package.sh
source "${_OKCP_LIB_DIR}/package.sh"

OKCP_VERSION="0.1.0"

usage() {
    cat <<'EOF'
ohos-kb — build OpenHarmony kernels with ophub-style lanes, configs and CI

USAGE
    ohos-kb <command> [lane] [options]

COMMANDS
    list-lanes [--status S]     show the lane matrix (the source of truth)
    list-lanes --ids            print just the lane ids, one per line
    show <lane>                 show one lane's resolved build parameters
    verify [--lane L]           re-check every lane against its remote Makefile
    fetch  <lane>               download the kernel source tree
    config <lane>               generate .config (OpenHarmony config repo)
    build  <lane>               cross-compile
    package <lane>              produce boot artifacts
    all    <lane>               fetch → patch → config → build → package
    doctor                      check this host for the tools a build needs
    clean  [--lane L] [--all]   remove build output
    help                         this text

LANE SELECTORS
    A lane is one buildable (kernel source, OpenHarmony branch) pair.
    Accepts an exact id, or any of:
        primary | latest                 the primary lane (6.6.101 on OHOS 7.0)
        OpenHarmony-7.0-Release          an OpenHarmony branch
        6.6.101                          a kernel version (prefix match)
        6.6.101@OpenHarmony-7.0-Release  both

BUILD OPTIONS
    --lane ID             act on this lane instead of the positional one
    --board NAME          OpenHarmony board layer (e.g. rk3568, qemu)
    --type standard|small OpenHarmony system type       [standard]
    --arch arm64|arm      target architecture            [auto]
    --toolchain host|ID    cross compiler: a host install, or an id from
                          data/toolchains.tsv              [host]
    --cc <alias>           deprecated alias for --toolchain
    --packager ohos|standalone                            [standalone]
    --targets "Image dtbs modules"                        [default set]
    --sign SUFFIX         append a LOCALVERSION suffix   [off]
    --config PATH         explicit defconfig or fragment
    --no-ohos-config      do not use kernel_linux_config; overlay only
    --no-patch            skip patch application
    --jobs N              parallelism                    [nproc]
    --workdir DIR         build root                     [./build]
    --out DIR             artifact directory             [<workdir>/artifacts/<lane>]
    --fetch-attempts N    clone retries per mirror       [10]
    --keep-source         do not wipe the source tree on failure
    --keep-going          build with 'make -k' so one run reports every
                          error, not just the first
    --debug               verbose logging

EXAMPLES
    ohos-kb list-lanes
    ohos-kb all primary --board rk3568
    ohos-kb all ohos-7.0-5.10 --type small
    ohos-kb build 6.6.101@OpenHarmony-7.0-Release --cc gcc
    ohos-kb verify

LICENSE
    GPL-2.0-only.  See LICENSE, NOTICE, AUTHORS and THIRD_PARTY_LICENSES.md.
EOF
}

#------------------------------------------------------------------ globals
LANE=""
DO_FETCH=1
DO_PATCH=1
DO_CONFIG=1
DO_BUILD=1
DO_PACKAGE=1
CONFIG_ONLY=0
OPT_SIGN=""
OPT_OUT=""
OPT_TARGETS=""
OPT_LANE_ARG=""

set_lane() {
    local sel=${1:-primary}
    LANE=$(lane_resolve "${sel}")
}

lane_srcdir() { printf '%s\n' "${OKCP_WORKDIR}/src/${LANE}"; }

#------------------------------------------------------------ subcommands

cmd_list_lanes() {
    local status="${list_status:-}" ids_only="${ids_only:-0}"
    if [[ "${ids_only}" == "1" ]]; then
        if [[ -n "${status}" ]]; then lane_ids_by_status "${status}"; else lane_ids; fi
        return 0
    fi
    lane_table "${status}"
    echo
    echo "Total: $(lane_ids | wc -l) lanes"
    echo
    echo "  primary      the recommended target for new work"
    echo "  stable       tracks a current OpenHarmony release branch"
    echo "  legacy       older OpenHarmony branch, kept reproducible"
    echo "  experimental no OpenHarmony release has validated this lane"
}

cmd_show() {
    set_lane "${1:-primary}"
    echo "lane              : ${LANE}"
    echo "status            : $(lane_status "${LANE}")"
    echo "source kind       : $(lane_source_kind "${LANE}")"
    echo "source url        : $(lane_url "${LANE}")"
    echo "OpenHarmony branch: $(lane_ohos_branch "${LANE}")"
    echo "kernel version    : $(lane_kver "${LANE}")"
    echo "config overlay    : $(lane_overlay "${LANE}")  (configs/lanes/$(lane_overlay "${LANE}")/)"
    echo "system type       : ${OKCP_SYSTEM_TYPE}"
    echo "board             : ${OKCP_BOARD:-<none>}"
    echo "arch              : $(config_arch "${LANE}")"
    echo "patch series dir  : $(patch_series_for_lane "${LANE}")"
    echo "work dir          : $(lane_srcdir)"
    echo
    local n
    n=$(collect_patches "${LANE}" | wc -l)
    echo "patches to apply  : ${n}"
    collect_patches "${LANE}" | sed 's/^/    /'
}

cmd_verify() {
    local only="${1:-}"
    local -a lanes
    if [[ -n "${only}" ]]; then lanes=("$(lane_resolve "${only}")"); else mapfile -t lanes < <(lane_ids); fi
    local pass=0 drift=0 fail=0 id declared actual
    for id in "${lanes[@]}"; do
        declared=$(lane_kver "${id}" 2>/dev/null || echo '?')
        actual=$(lane_verify_kver_remote "${id}" 2>/dev/null || echo 'ERROR')
        if [[ "${actual}" == "ERROR" || -z "${actual}" ]]; then
            printf '  %-24s %-9s %s\n' "${id}" "FAIL" "could not reach remote"
            fail=$((fail+1))
        elif [[ "${actual}" == "${declared}" ]]; then
            printf '  %-24s %-9s %s\n' "${id}" "ok" "${actual}"
            pass=$((pass+1))
        else
            printf '  %-24s %-9s matrix=%s remote=%s\n' "${id}" "DRIFT" "${declared}" "${actual}"
            drift=$((drift+1))
        fi
    done
    echo
    echo "verified ${pass}, drift ${drift}, failed ${fail}"
    [[ ${fail} -eq 0 ]]
}

# Read the remote Makefile without cloning the tree, for `verify`.
lane_verify_kver_remote() {
    local lane=$1 url branch repo host url_base
    url=$(lane_url "${lane}")
    branch=$(lane_ohos_branch "${lane}")
    [[ "${branch}" == "-" ]] && return 1
    repo=$(lane_repo "${lane}")
    host=$(lane_host "${lane}"); host=${host#https://}; host=${host%/}
    url_base=${host%%/*}

    local raw=""
    local tmp; tmp=$(make_tmpdir)
    local api="https://api.gitcode.com/api/v5/repos/openharmony/${repo}/contents/Makefile?ref=${branch}"
    raw=$(retry 2 5 curl -fsSL --max-time 30 "${api}" 2>/dev/null || true)
    if [[ -n "${raw}" ]]; then
        python3 - "$raw" <<'PY' 2>/dev/null || true
import sys,json,base64,re
try:
    d=json.loads(sys.argv[1])
    t=base64.b64decode(d["content"]).decode("utf-8","replace")
except Exception:
    sys.exit(1)
g={}
for l in t.splitlines()[:20]:
    m=re.match(r"^(VERSION|PATCHLEVEL|SUBLEVEL)\s*=\s*(\S+)",l)
    if m: g[m.group(1)]=m.group(2)
if len(g)==3: print("%s.%s.%s"%(g["VERSION"],g["PATCHLEVEL"],g["SUBLEVEL"]))
else: sys.exit(1)
PY
        rm -rf "${tmp}"; return 0
    fi
    rm -rf "${tmp}"
    log_debug "gitcode contents API unavailable for ${repo}@${branch}"
    return 1
}

cmd_doctor() {
    log_step "ohos-kb ${OKCP_VERSION} environment check"
    printf '  %-24s %s\n' "repository root" "${OKCP_ROOT}"
    printf '  %-24s %s\n' "lane matrix" "${OKCP_LANES_FILE}"
    printf '  %-24s %s\n' "lanes defined" "$(lane_ids | wc -l)"

    local t
    for t in git curl make gcc tar find awk sed grep python3; do
        if have "${t}"; then
            printf '  %-24s %s %s\n' "${t}" "${_C_G}✔${_C_RST}" "$(command -v "${t}")"
        else
            printf '  %-24s %s MISSING\n' "${t}" "${_C_R}✘${_C_RST}"
        fi
    done
    for t in aarch64-linux-gnu-gcc clang ccache mkbootimg modinfo; do
        if have "${t}"; then
            printf '  %-24s %s %s\n' "${t}" "${_C_G}✔${_C_RST}" "$(command -v "${t}")"
        else
            printf '  %-24s %s not on PATH (optional / fetched by CI)\n' "${t}" "${_C_Y}~${_C_RST}"
        fi
    done
    echo
    if have aarch64-linux-gnu-gcc; then
        log_ok "a cross toolchain is available; a real build is possible here"
    else
        log_warn "no aarch64 cross compiler on PATH."
        log_warn "  install: sudo apt-get install -y gcc-aarch64-linux-gnu bc bison flex libssl-dev"
        log_warn "  or let CI build it: see .github/workflows/"
    fi
}

cmd_clean() {
    local all=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) all=1; shift ;;
            *) set_lane "$1"; shift ;;
        esac
    done
    if [[ "${all}" == "1" ]]; then
        log_step "removing ${OKCP_WORKDIR}"
        [[ "${OKCP_WORKDIR}" == "/" || -z "${OKCP_WORKDIR}" ]] && die "refusing to remove '${OKCP_WORKDIR}'"
        rm -rf "${OKCP_WORKDIR}"
        log_ok "cleaned"
        return 0
    fi
    local sd; sd=$(lane_srcdir)
    log_step "removing source tree and artifacts for ${LANE}"
    rm -rf "${sd}" "${OKCP_ARTIFACT_DIR}/${LANE}"
    log_ok "cleaned ${LANE}"
}

cmd_fetch()   { set_lane "${1:-${OPT_LANE_ARG:-primary}}"; fetch_kernel_source "${LANE}" >/dev/null; }
cmd_config()  { set_lane "${1:-${OPT_LANE_ARG:-primary}}"; local sd; sd=$(lane_srcdir)
                 require_file "${sd}/Makefile" || die "run 'ohos-kb fetch ${LANE}' first"
                 generate_config "${LANE}" "${sd}" "$(lane_outdir "${LANE}")" >/dev/null; }
# Resolve the toolchain into the environment variables kbuild_args consumes,
# before any make runs.  A toolchain id from data/toolchains.tsv downloads and
# unpacks; "host" uses the aarch64 cross compiler already installed.
setup_build_toolchain() {
    local tc=${1:-${OKCP_TOOLCHAIN:-host}}
    [[ -n "${tc}" ]] || tc=host
    if [[ "${tc}" == "host" ]]; then
        if ! host_toolchain_prefix >/dev/null 2>&1; then
            log_warn "no aarch64 cross compiler found on PATH."
            log_warn "  install one:      sudo apt-get install -y gcc-aarch64-linux-gnu"
            log_warn "  or name a table entry: ohos-kb build ${LANE} --toolchain $(tc_ids | head -1)"
            return 0
        fi
        export OKCP_CROSS_COMPILE
        OKCP_CROSS_COMPILE=$(host_toolchain_prefix)
        log_ok "toolchain: ${OKCP_CROSS_COMPILE}gcc (host)"
        return 0
    fi
    # Validate the id against the table, in THIS shell.
    #
    # Two separate reasons this cannot be left to a helper: a process
    # substitution runs in a subshell, where die() only leaves that subshell —
    # mapfile would return empty and the build would carry on with no compiler.
    # And tc_select does not validate an id at all; it picks a *default*, so
    # asking it about "no-such-toolchain" happily returns a working entry and
    # the real lookup then builds a URL with an empty filename.
    if ! tc_ids | grep -qx -- "${tc}"; then
        log_error "unknown toolchain id '${tc}'"
        log_error "  available:"
        tc_table | sed 's/^/    /'
        die "pick one of the ids above, or use --toolchain host"
    fi

    local -a envlines=()
    mapfile -t envlines < <(toolchain_env "${tc}" || true)
    if [[ ${#envlines[@]} -eq 0 ]]; then
        die "toolchain_env produced nothing for '${tc}'
  The download may have failed; run with --debug for the underlying error."
    fi
    local l
    for l in "${envlines[@]}"; do
        if [[ "${l}" != *=* ]]; then
            die "toolchain_env emitted a malformed line: '${l}'"
        fi
        export "${l?}"
    done
    log_ok "toolchain: ${OKCP_CROSS_COMPILE}gcc from ${OKCP_TOOLCHAIN_PREFIX:-the table}"
}

cmd_build()   { set_lane "${1:-${OPT_LANE_ARG:-primary}}"; local sd kd; sd=$(lane_srcdir); kd=$(lane_outdir "${LANE}")
                 require_file "${kd}/.config" || die "no configuration for ${LANE}
  The build is out-of-tree, so the config lives at the kbuild directory:
    ${kd#"${OKCP_ROOT}"/}/.config
  Run: ohos-kb config ${LANE}"
                 setup_build_toolchain
                 if [[ -n "${OPT_SIGN}" ]]; then stamp_version "${sd}" "${OPT_SIGN}" "$(lane_arch "${LANE}")"; fi
                 build_kernel "${LANE}" "${sd}" "$(lane_outdir "${LANE}")" >/dev/null; }
cmd_package() { set_lane "${1:-${OPT_LANE_ARG:-primary}}"; local sd; sd=$(lane_srcdir)
                 require_file "${sd}/Makefile" || die "run 'ohos-kb fetch ${LANE}' first"
                 package_kernel "${LANE}" "${sd}" "${OPT_OUT:-${OKCP_ARTIFACT_DIR}/${LANE}}" >/dev/null; }

cmd_all() {
    set_lane "${1:-${OPT_LANE_ARG:-primary}}"
    local sd start; sd=$(lane_srcdir); start=${SECONDS}
    log_step "lane ${LANE} ($(lane_kver "${LANE}"), $(lane_ohos_branch "${LANE}"))"
    (( DO_FETCH ))    && cmd_fetch    "${LANE}"
    (( DO_PATCH ))    && apply_patches "${LANE}" "${sd}"
    (( DO_CONFIG ))   && cmd_config   "${LANE}"
    (( DO_BUILD ))    && cmd_build    "${LANE}"
    (( DO_PACKAGE ))  && cmd_package  "${LANE}"
    log_ok "lane ${LANE} complete in $(fmt_duration $((SECONDS - start)))"
    log_info "artifacts: ${OKCP_ARTIFACT_DIR}/${LANE}"
}

#-------------------------------------------------------------- dispatch
main() {
    [[ $# -eq 0 ]] && { usage; exit 0; }
    local cmd=$1; shift

    # Pre-scan flags so that a lane can appear anywhere.
    local -a rest=()
    # main pre-scans every option, so subcommand-specific flags must be
    # registered here as well; cmd_list_lanes reads these, not its own copies.
    local ids_only=0
    local list_status=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lane)        LANE=$(lane_resolve "${2:-primary}"); shift 2 ;;
            --board)       OKCP_BOARD=${2:-}; export OKCP_BOARD; shift 2 ;;
            --type)        OKCP_SYSTEM_TYPE=${2:-standard}; export OKCP_SYSTEM_TYPE; shift 2 ;;
            --arch)        OKCP_ARCH=${2:-}; export OKCP_ARCH; shift 2 ;;
            --cc)          OKCP_TOOLCHAIN=${2:-host}; export OKCP_TOOLCHAIN; shift 2 ;;
            --toolchain)   OKCP_TOOLCHAIN=${2:-host}; export OKCP_TOOLCHAIN; shift 2 ;;
            --packager)    OKCP_PACKAGER=${2:-standalone}; export OKCP_PACKAGER; shift 2 ;;
            --ids)         ids_only=1; shift ;;
            --status)      list_status=${2:-}; shift 2 ;;
            --targets)     OPT_TARGETS=${2:-}; shift 2 ;;
            --sign)        OPT_SIGN=${2:-}; shift 2 ;;
            --config)      OKCP_CONFIG_OVERRIDE=${2:-}; export OKCP_CONFIG_OVERRIDE; shift 2 ;;
            --no-ohos-config) OKCP_NO_OHOS_CONFIG=1; export OKCP_NO_OHOS_CONFIG; shift ;;
            --no-patch)    DO_PATCH=0; shift ;;
            --no-fetch)    DO_FETCH=0; shift ;;
            --no-build)    DO_BUILD=0; shift ;;
            --no-package)  DO_PACKAGE=0; shift ;;
            --config-only) DO_BUILD=0; DO_PACKAGE=0; shift ;;
            --jobs)        OKCP_JOBS=${2:-}; export OKCP_JOBS; shift 2 ;;
            --workdir)     OKCP_WORKDIR=$(abspath "${2:-build}"); export OKCP_WORKDIR; shift 2 ;;
            --out)         OPT_OUT=$(abspath "${2:-}"); shift 2 ;;
            --fetch-attempts) OKCP_FETCH_ATTEMPTS=${2:-10}; shift 2 ;;
            --keep-source)  OKCP_KEEP_SOURCE=1; shift ;;
            --keep-going)   OKCP_KEEP_GOING=1; shift ;;
            --debug)        OKCP_DEBUG=1; shift ;;
            -h|--help)      usage; exit 0 ;;
            -*)             die "unknown option: $1 (try: ohos-kb help)" ;;
            *)              rest+=("$1"); shift ;;
        esac
    done
    set -- ${rest[@]+"${rest[@]}"}

    case "${cmd}" in
        list-lanes) cmd_list_lanes "$@" ;;
        show)       cmd_show "${1:-${LANE:-primary}}" ;;
        verify)     cmd_verify "${1:-}" ;;
        doctor)     cmd_doctor ;;
        clean)      [[ -n "${LANE}" ]] || LANE=""; if [[ ${#rest[@]} -gt 0 ]]; then set_lane "${rest[0]}"; fi; cmd_clean "$@" ;;
        fetch)      [[ ${#rest[@]} -gt 0 ]] && OPT_LANE_ARG=${rest[0]}; cmd_fetch "${OPT_LANE_ARG:-${LANE:-primary}}" ;;
        config)     [[ ${#rest[@]} -gt 0 ]] && OPT_LANE_ARG=${rest[0]}; cmd_config "${OPT_LANE_ARG:-${LANE:-primary}}" ;;
        build)      [[ ${#rest[@]} -gt 0 ]] && OPT_LANE_ARG=${rest[0]}; cmd_build  "${OPT_LANE_ARG:-${LANE:-primary}}" ;;
        package)    [[ ${#rest[@]} -gt 0 ]] && OPT_LANE_ARG=${rest[0]}; cmd_package "${OPT_LANE_ARG:-${LANE:-primary}}" ;;
        all)        [[ ${#rest[@]} -gt 0 ]] && OPT_LANE_ARG=${rest[0]}; cmd_all "${OPT_LANE_ARG:-${LANE:-primary}}" ;;
        version|--version) echo "ohos-kb ${OKCP_VERSION}" ;;
        help|-h|--help) usage ;;
        *) log_error "unknown command: ${cmd}"; echo; usage; exit 1 ;;
    esac
}

main "$@"
