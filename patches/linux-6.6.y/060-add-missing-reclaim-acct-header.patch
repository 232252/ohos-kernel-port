From 9754e46b693fec728587783a0e41362d0e0fe9f4 Mon Sep 17 00:00:00 2001
From: ohos-kernel-port contributors <232252@users.noreply.github.com>
Date: Mon, 5 Oct 2026 09:08:50 +0800
Subject: [PATCH] include: add reclaim_acct.h, taken from the OpenHarmony 5.10
 tree

SPDX-License-Identifier: GPL-2.0-only

Baseline: gitcode.com/openharmony/kernel_linux_6.6
Branch:   OpenHarmony-7.0-Release
Commit:   f4b61510491aa20f7f57fbbc5efc754083c92212

    fatal error: linux/reclaim_acct.h: No such file or directory

Six files include <linux/reclaim_acct.h> and it is not tracked in the 6.6 tree:
init/main.c, kernel/fork.c, mm/internal.h, mm/page_alloc.c, mm/vmscan.c and
mm/zswapd.c.  mm/internal.h and init/main.c are on every build's path, so this
is not conditional.

Taken from kernel_linux_5.10 in the same release, with the SPDX tag narrowed to
GPL-2.0-only to match the 6.6 tree.  See 020, 030, 050 and 070: the 6.6 tree is
missing a set of headers that the 5.10 tree carries, and this is the sixth.

Upstream: no equivalent; Linux v6.6 has no reclaim_acct.h.
Licence: GPL-2.0-only, same as the tree.
---
 include/linux/reclaim_acct.h | 48 ++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 include/linux/reclaim_acct.h

diff --git a/include/linux/reclaim_acct.h b/include/linux/reclaim_acct.h
new file mode 100644
index 0000000..591236f
--- /dev/null
+++ b/include/linux/reclaim_acct.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * include/linux/reclaim_acct.h
+ *
+ * Copyright (c) 2022 Huawei Technologies Co., Ltd.
+ */
+
+#ifndef _RECLAIM_ACCT_H
+#define _RECLAIM_ACCT_H
+
+#include <linux/sched.h>
+#include <linux/shrinker.h>
+
+/* RA is the abbreviation of reclaim accouting */
+enum reclaimacct_stubs {
+	RA_RECLAIM = 0,
+	RA_DRAINALLPAGES,
+	RA_SHRINKFILE,
+	RA_SHRINKANON,
+	RA_SHRINKSLAB,
+	NR_RA_STUBS
+};
+
+enum reclaim_type {
+	DIRECT_RECLAIMS = 0,
+	KSWAPD_RECLAIM,
+	ZSWAPD_RECLAIM,
+	RECLAIM_TYPES
+};
+
+#ifdef CONFIG_RECLAIM_ACCT
+static inline bool is_system_reclaim(enum reclaim_type type)
+{
+	return (type == KSWAPD_RECLAIM || type == ZSWAPD_RECLAIM);
+}
+
+void reclaimacct_tsk_init(struct task_struct *tsk);
+void reclaimacct_init(void);
+
+void reclaimacct_start(enum reclaim_type type, struct reclaim_acct *ra);
+void reclaimacct_end(enum reclaim_type type);
+
+void reclaimacct_substage_start(enum reclaimacct_stubs stub);
+void reclaimacct_substage_end(enum reclaimacct_stubs stub, unsigned long freed,
+				const struct shrinker *shrinker);
+#endif
+
+#endif /* _RECLAIM_ACCT_H */
-- 
2.39.5

