From 40f4999f591d19c00872d5772bcf65e110dcc581 Mon Sep 17 00:00:00 2001
From: ohos-kernel-port contributors <232252@users.noreply.github.com>
Date: Sun, 4 Oct 2026 23:40:34 +0800
Subject: [PATCH] include: add the missing xpm_types.h so mm_types.h can be
 compiled
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SPDX-License-Identifier: GPL-2.0-only

Baseline: gitcode.com/openharmony/kernel_linux_6.6
Branch:   OpenHarmony-7.0-Release
Commit:   f4b61510491aa20f7f57fbbc5efc754083c92212

With the dangling Kconfig sources resolved, kconfig runs to completion and the
compile reaches the first C file, where it stops:

    CC      arch/arm64/kernel/asm-offsets.s
    In file included from include/linux/mm_types.h:22:
    include/linux/mm_types.h:22:10: fatal error: linux/xpm_types.h:
        No such file or directory
       22 | #include <linux/xpm_types.h>
          |          ^~~~~~~~~~~~~~~~~~~

include/linux/xpm_types.h is not tracked in the repository, and neither
struct xpm_region nor struct cs_info is defined anywhere in the tree.  Three
files include it:

    include/linux/mm_types.h:22
    include/linux/hck/lite_hck_code_sign.h:9
    fs/verity/fsverity_private.h:15

The include in mm_types.h is unconditional while the uses are conditional:

    #ifdef CONFIG_SECURITY_XPM
            struct xpm_region xpm_region;
    #endif
    #ifdef CONFIG_SECURITY_CODE_SIGN
            struct cs_info pcs_info;
    #endif

kernel_linux_config/linux-6.6/base_defconfig:18 sets CONFIG_SECURITY_XPM=y, so
the first branch is compiled and struct xpm_region has to be a complete type
that can be embedded by value.  Disabling the option does not help: the include
is still there.

This adds the header with declaration-only types.  It edits no existing file,
which is deliberate — mm_types.h is core, and supplying a missing header is
safer than editing one.  The field layouts are placeholders, not the real XPM
ABI; no xpm implementation exists in this tree to have an ABI.

Note that include/linux/hck/lite_hck_xpm.h IS present, and carries
"Copyright (c) 2023 Huawei Device Co., Ltd."  So the xpm feature is partially
landed, which is consistent with the pattern here: the Kconfig sources, the
Makefile hooks and the mm_types.h field were all added, and the
implementation directories were not.

When OpenHarmony ships xpm, delete this file together with the include lines
and the obj- entries in security/Makefile.

Upstream: no equivalent change; Linux v6.6 has no xpm_types.h and no reference
to xpm from mm_types.h.
Licence: GPL-2.0-only, same as the tree.
---
 include/linux/xpm_types.h | 49 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)
 create mode 100644 include/linux/xpm_types.h

diff --git a/include/linux/xpm_types.h b/include/linux/xpm_types.h
new file mode 100644
index 0000000..95c7459
--- /dev/null
+++ b/include/linux/xpm_types.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Compatibility shim for the OpenHarmony XPM (XPM) subsystem.
+ *
+ * This tree includes <linux/xpm_types.h> from three places:
+ *
+ *     include/linux/mm_types.h:22
+ *     include/linux/hck/lite_hck_code_sign.h:9
+ *     fs/verity/fsverity_private.h:15
+ *
+ * but never ships the header.  The include in mm_types.h is unconditional
+ * while the uses are conditional:
+ *
+ *     #ifdef CONFIG_SECURITY_XPM
+ *             struct xpm_region xpm_region;
+ *     #endif
+ *     #ifdef CONFIG_SECURITY_CODE_SIGN
+ *             struct cs_info pcs_info;
+ *     #endif
+ *
+ * kernel_linux_config/linux-6.6/base_defconfig sets CONFIG_SECURITY_XPM=y, so
+ * the first branch is compiled and struct xpm_region must be a complete type
+ * that can be embedded by value in mm_struct.  That is why this cannot be
+ * solved by turning the option off: the include would still be there.
+ *
+ * No xpm implementation exists in this tree, so these types are declarations
+ * only.  The layouts below are placeholders, not the real XPM ABI.  When
+ * OpenHarmony lands the subsystem this file must be deleted along with the
+ * include lines and the obj- entries in security/Makefile.
+ */
+#ifndef _LINUX_XPM_TYPES_H
+#define _LINUX_XPM_TYPES_H
+
+#include <linux/types.h>
+
+/* Placeholder for the per-mm XPM region.  No implementation exists here. */
+struct xpm_region {
+	/* Reserved so the type is complete and embeddable by value.  The real
+	 * XPM ABI would define this properly; do not read or write it. */
+	u64 xpm_reserved;
+};
+
+/* Referenced under CONFIG_SECURITY_CODE_SIGN, which no OpenHarmony 6.6
+ * configuration enables.  Declared for completeness. */
+struct cs_info {
+	u64 cs_reserved;
+};
+
+#endif /* _LINUX_XPM_TYPES_H */
-- 
2.39.5

