From f98c1214cfa122b7e8ca930ff5fee42d8507e5dc Mon Sep 17 00:00:00 2001
From: ohos-kernel-port contributors <232252@users.noreply.github.com>
Date: Mon, 5 Oct 2026 09:08:23 +0800
Subject: [PATCH] fs,security: make the Kconfig graph resolvable without
 dropping symbols
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SPDX-License-Identifier: GPL-2.0-only

Baseline: gitcode.com/openharmony/kernel_linux_6.6
Branch:   OpenHarmony-7.0-Release
Commit:   f4b61510491aa20f7f57fbbc5efc754083c92212
Found by: tools/audit-kconfig.py

Three Kconfig files are sourced but are not tracked in the repository:

    fs/Kconfig:131       -> fs/code_sign/Kconfig
    fs/Kconfig:133       -> fs/dec/Kconfig
    security/Kconfig:230 -> security/container_escape_detection/Kconfig

Without this patch kbuild cannot start at all:

    fs/Kconfig:131: can't open file "fs/code_sign/Kconfig"
    make[3]: *** [scripts/kconfig/Makefile:77: olddefconfig] Error 1

This also adds declaration-only Kconfig for the two subsystems OpenHarmony
configures but does not ship, memory_security and xpm, and deliberately keeps
their source lines.  Removing a source line instead is a trap: with the symbol
undefined, olddefconfig silently drops CONFIG_SECURITY_XPM even though
base_defconfig sets it, and the CONFIG_SECURITY_XPM blocks in page-flags.h and
mm_types.h then take their #else branches — which is how an earlier attempt at
this patch produced an arity error two files away from the real cause.

The obj-/subdir- lines that name the absent directories are removed instead:
enabling the options now builds nothing, which is the true state of the tree.

Upstream: no equivalent; none of these files are part of Linux v6.6.
Licence: GPL-2.0-only, same as the tree.
---
 fs/Kconfig                      |  4 ----
 fs/proc/Makefile                |  1 -
 fs/proc/memory_security/Kconfig |  8 ++++++++
 security/Kconfig                |  1 -
 security/Makefile               |  3 ---
 security/xpm/Kconfig            | 17 +++++++++++++++++
 6 files changed, 25 insertions(+), 9 deletions(-)
 create mode 100644 fs/proc/memory_security/Kconfig
 create mode 100644 security/xpm/Kconfig

diff --git a/fs/Kconfig b/fs/Kconfig
index dc6d084..f758aa3 100644
--- a/fs/Kconfig
+++ b/fs/Kconfig
@@ -129,10 +129,6 @@ config FILE_LOCKING
 
 source "fs/crypto/Kconfig"
 
-source "fs/code_sign/Kconfig"
-
-source "fs/dec/Kconfig"
-
 source "fs/verity/Kconfig"
 
 source "fs/notify/Kconfig"
diff --git a/fs/proc/Makefile b/fs/proc/Makefile
index 04a0dd7..bd08616 100644
--- a/fs/proc/Makefile
+++ b/fs/proc/Makefile
@@ -34,4 +34,3 @@ proc-$(CONFIG_PROC_VMCORE)	+= vmcore.o
 proc-$(CONFIG_PRINTK)	+= kmsg.o
 proc-$(CONFIG_PROC_PAGE_MONITOR)	+= page.o
 proc-$(CONFIG_BOOT_CONFIG)	+= bootconfig.o
-obj-$(CONFIG_MEMORY_SECURITY) += memory_security/
diff --git a/fs/proc/memory_security/Kconfig b/fs/proc/memory_security/Kconfig
new file mode 100644
index 0000000..6d9e0ad
--- /dev/null
+++ b/fs/proc/memory_security/Kconfig
@@ -0,0 +1,8 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Declared for configuration compatibility only.  This tree ships no
+# implementation of the memory_security subsystem, so enabling this option
+# builds nothing.  It exists so that board configurations which request
+# CONFIG_MEMORY_SECURITY=y keep validating.
+config MEMORY_SECURITY
+	bool
diff --git a/security/Kconfig b/security/Kconfig
index a221245..3626fc4 100644
--- a/security/Kconfig
+++ b/security/Kconfig
@@ -227,7 +227,6 @@ source "security/safesetid/Kconfig"
 source "security/lockdown/Kconfig"
 source "security/xpm/Kconfig"
 source "security/landlock/Kconfig"
-source "security/container_escape_detection/Kconfig"
 
 source "security/integrity/Kconfig"
 
diff --git a/security/Makefile b/security/Makefile
index 1fbed3e..18121f8 100644
--- a/security/Makefile
+++ b/security/Makefile
@@ -4,7 +4,6 @@
 #
 
 obj-$(CONFIG_KEYS)			+= keys/
-subdir-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection
 
 # always enable default capabilities
 obj-y					+= commoncap.o
@@ -24,9 +23,7 @@ obj-$(CONFIG_SECURITY_SAFESETID)       += safesetid/
 obj-$(CONFIG_SECURITY_LOCKDOWN_LSM)	+= lockdown/
 obj-$(CONFIG_CGROUPS)			+= device_cgroup.o
 obj-$(CONFIG_BPF_LSM)			+= bpf/
-obj-$(CONFIG_SECURITY_XPM)		+= xpm/
 obj-$(CONFIG_SECURITY_LANDLOCK)		+= landlock/
-obj-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection/
 
 # Object integrity file lists
 obj-$(CONFIG_INTEGRITY)			+= integrity/
diff --git a/security/xpm/Kconfig b/security/xpm/Kconfig
new file mode 100644
index 0000000..7ebb7cf
--- /dev/null
+++ b/security/xpm/Kconfig
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Declared for configuration compatibility only.  kernel_linux_config sets
+# CONFIG_SECURITY_XPM in its 6.6 base_defconfig, and the rk3568 board
+# configuration sets CONFIG_SECURITY_XPM_DEBUG, but this tree ships no
+# implementation of the xpm subsystem, so enabling these options builds
+# nothing.  The obj- line in security/Makefile has been removed for that
+# reason.  The source line in security/Kconfig is deliberately kept: without it
+# the symbol would be unknown, olddefconfig would silently drop it, and the
+# CONFIG_SECURITY_XPM blocks elsewhere (page-flags.h, mm_types.h) would take
+# their #else branches instead.
+config SECURITY_XPM
+	bool "OpenHarmony XPM (declared only; no implementation in this tree)"
+
+config SECURITY_XPM_DEBUG
+	bool "XPM debugging (declared only; no implementation in this tree)"
+	depends on SECURITY_XPM
-- 
2.39.5

