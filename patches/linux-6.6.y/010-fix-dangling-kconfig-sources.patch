From 7aba42102060c8edf133c1b9c1edadc719f19074 Mon Sep 17 00:00:00 2001
From: ohos-kernel-port contributors <232252@users.noreply.github.com>
Date: Sun, 4 Oct 2026 23:18:18 +0800
Subject: [PATCH] fs,security: make the 6.6 tree's Kconfig references
 resolvable

SPDX-License-Identifier: GPL-2.0-only

Baseline: gitcode.com/openharmony/kernel_linux_6.6
Branch:   OpenHarmony-7.0-Release
Commit:   f4b61510491aa20f7f57fbbc5efc754083c92212
Found by: tools/audit-kconfig.py

Five Kconfig files are sourced but are not tracked in the repository:

    fs/Kconfig:54        -> fs/proc/memory_security/Kconfig
    fs/Kconfig:131       -> fs/code_sign/Kconfig
    fs/Kconfig:133       -> fs/dec/Kconfig
    security/Kconfig:228 -> security/xpm/Kconfig
    security/Kconfig:230 -> security/container_escape_detection/Kconfig

Verified absent from OpenHarmony-6.0-Release, -6.1-Release, -7.0-Beta1 and
-7.0-Release.  Upstream Linux v6.6 references none of them, so this is an
OpenHarmony addition that was never completed.

The effect is that kbuild cannot start at all on a pristine clone:

    $ make O=out ARCH=arm64 olddefconfig
    fs/Kconfig:54: can't open file "fs/proc/memory_security/Kconfig"
    make[3]: *** [scripts/kconfig/Makefile:77: olddefconfig] Error 1

kconfig stops at the first unresolved source, so a build reveals these one at
a time.  tools/audit-kconfig.py in this project walks the whole tree and
reports all five at once.

Two Makefiles compound it, naming directories that do not exist:

    fs/proc/Makefile:37  obj-$(CONFIG_MEMORY_SECURITY) += memory_security/
    security/Makefile:7      subdir-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection
    security/Makefile:27     obj-$(CONFIG_SECURITY_XPM) += xpm/
    security/Makefile:29     obj-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection/

Why the symbols cannot simply be deleted
----------------------------------------
kernel_linux_config/linux-6.6/base_defconfig:18 sets CONFIG_SECURITY_XPM=y,
and rk3568/arch/arm64_defconfig sets CONFIG_SECURITY_XPM_DEBUG=y (line 6162)
and CONFIG_MEMORY_SECURITY=y (line 6174).  Removing those Kconfig files would
let olddefconfig discard the symbols silently, and a board configuration would
quietly lose settings it asks for.

What this patch does
--------------------
1. Adds declaration-only Kconfig for memory_security and xpm, defining
   MEMORY_SECURITY, SECURITY_XPM and SECURITY_XPM_DEBUG so the options resolve
   and the existing configurations validate.  There is no implementation in
   this tree to compile.
2. Removes the four obj-/subdir- lines, because the directories they name do
   not exist.  Enabling the options now builds nothing extra, which is the
   true state of the tree.
3. Removes the source lines for fs/code_sign, fs/dec and
   security/container_escape_detection.  No configuration references a symbol
   from any of them and nothing builds them, so these are dead references
   rather than missing declarations.

When OpenHarmony lands the real subsystems this patch should be dropped: the
files and the obj- lines will exist, and ohos-kb will report that the patch no
longer applies rather than silently mis-building.

Upstream: no equivalent change; these files are not part of Linux v6.6.
Licence: GPL-2.0-only, same as the tree.
---
 fs/Kconfig                      |  6 ------
 fs/proc/Makefile                |  1 -
 fs/proc/memory_security/Kconfig |  8 ++++++++
 security/Kconfig                |  2 --
 security/Makefile               |  3 ---
 security/xpm/Kconfig            | 13 +++++++++++++
 6 files changed, 21 insertions(+), 12 deletions(-)
 create mode 100644 fs/proc/memory_security/Kconfig
 create mode 100644 security/xpm/Kconfig

diff --git a/fs/Kconfig b/fs/Kconfig
index dc6d084..19d4c08 100644
--- a/fs/Kconfig
+++ b/fs/Kconfig
@@ -51,8 +51,6 @@ source "fs/btrfs/Kconfig"
 source "fs/nilfs2/Kconfig"
 source "fs/f2fs/Kconfig"
 source "fs/zonefs/Kconfig"
-source "fs/proc/memory_security/Kconfig"
-
 endif # BLOCK
 
 config FS_DAX
@@ -129,10 +127,6 @@ config FILE_LOCKING
 
 source "fs/crypto/Kconfig"
 
-source "fs/code_sign/Kconfig"
-
-source "fs/dec/Kconfig"
-
 source "fs/verity/Kconfig"
 
 source "fs/notify/Kconfig"
diff --git a/fs/proc/Makefile b/fs/proc/Makefile
index 04a0dd7..bd08616 100644
--- a/fs/proc/Makefile
+++ b/fs/proc/Makefile
@@ -34,4 +34,3 @@ proc-$(CONFIG_PROC_VMCORE)	+= vmcore.o
 proc-$(CONFIG_PRINTK)	+= kmsg.o
 proc-$(CONFIG_PROC_PAGE_MONITOR)	+= page.o
 proc-$(CONFIG_BOOT_CONFIG)	+= bootconfig.o
-obj-$(CONFIG_MEMORY_SECURITY) += memory_security/
diff --git a/fs/proc/memory_security/Kconfig b/fs/proc/memory_security/Kconfig
new file mode 100644
index 0000000..6d9e0ad
--- /dev/null
+++ b/fs/proc/memory_security/Kconfig
@@ -0,0 +1,8 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Declared for configuration compatibility only.  This tree ships no
+# implementation of the memory_security subsystem, so enabling this option
+# builds nothing.  It exists so that board configurations which request
+# CONFIG_MEMORY_SECURITY=y keep validating.
+config MEMORY_SECURITY
+	bool
diff --git a/security/Kconfig b/security/Kconfig
index a221245..39af8b8 100644
--- a/security/Kconfig
+++ b/security/Kconfig
@@ -225,9 +225,7 @@ source "security/loadpin/Kconfig"
 source "security/yama/Kconfig"
 source "security/safesetid/Kconfig"
 source "security/lockdown/Kconfig"
-source "security/xpm/Kconfig"
 source "security/landlock/Kconfig"
-source "security/container_escape_detection/Kconfig"
 
 source "security/integrity/Kconfig"
 
diff --git a/security/Makefile b/security/Makefile
index 1fbed3e..18121f8 100644
--- a/security/Makefile
+++ b/security/Makefile
@@ -4,7 +4,6 @@
 #
 
 obj-$(CONFIG_KEYS)			+= keys/
-subdir-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection
 
 # always enable default capabilities
 obj-y					+= commoncap.o
@@ -24,9 +23,7 @@ obj-$(CONFIG_SECURITY_SAFESETID)       += safesetid/
 obj-$(CONFIG_SECURITY_LOCKDOWN_LSM)	+= lockdown/
 obj-$(CONFIG_CGROUPS)			+= device_cgroup.o
 obj-$(CONFIG_BPF_LSM)			+= bpf/
-obj-$(CONFIG_SECURITY_XPM)		+= xpm/
 obj-$(CONFIG_SECURITY_LANDLOCK)		+= landlock/
-obj-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection/
 
 # Object integrity file lists
 obj-$(CONFIG_INTEGRITY)			+= integrity/
diff --git a/security/xpm/Kconfig b/security/xpm/Kconfig
new file mode 100644
index 0000000..d86ffdc
--- /dev/null
+++ b/security/xpm/Kconfig
@@ -0,0 +1,13 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Declared for configuration compatibility only.  kernel_linux_config sets
+# CONFIG_SECURITY_XPM in its 6.6 base_defconfig, and the rk3568 board
+# configuration sets CONFIG_SECURITY_XPM_DEBUG, but this tree ships no
+# implementation of the xpm subsystem, so enabling these options builds
+# nothing.  The obj- line in security/Makefile has been removed for that reason.
+config SECURITY_XPM
+	bool "OpenHarmony XPM (declared only; no implementation in this tree)"
+
+config SECURITY_XPM_DEBUG
+	bool "XPM debugging (declared only; no implementation in this tree)"
+	depends on SECURITY_XPM
-- 
