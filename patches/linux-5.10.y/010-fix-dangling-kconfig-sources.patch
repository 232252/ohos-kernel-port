From ead3cafb2e434ed12ea2e1a182919a37c609dfe1 Mon Sep 17 00:00:00 2001
From: ohos-kernel-port contributors <232252@users.noreply.github.com>
Date: Mon, 5 Oct 2026 08:30:18 +0800
Subject: [PATCH] fs,security: make the Kconfig graph resolvable without
 dropping symbols
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SPDX-License-Identifier: GPL-2.0-only

Baseline: gitcode.com/openharmony/kernel_linux_5.10
Branch:   OpenHarmony-7.0-Release
Commit:   (OpenHarmony-7.0-Release, as pinned by the 7.0 manifest)
Found by: tools/audit-kconfig.py

The 5.10 tree has the same five dangling Kconfig sources as the 6.6 tree:

    fs/Kconfig:119        -> fs/code_sign/Kconfig
    fs/Kconfig:121        -> fs/dec/Kconfig
    security/Kconfig:234  -> security/container_escape_detection/Kconfig
    and, like 6.6, memory_security and xpm are configured but not shipped

    $ make O=out ARCH=arm64 olddefconfig
    fs/Kconfig:119: can't open file "fs/code_sign/Kconfig"
    make[3]: *** [scripts/kconfig/Makefile:77: olddefconfig] Error 1

Unlike 6.6, the 5.10 tree does carry include/linux/xpm_types.h,
include/linux/memcg_policy.h and include/linux/mm_purgeable.h, so this series
is the whole of what the 5.10 lanes need — the four later patches exist only to
supply headers that 5.10 already has.

The same two-part reasoning as the 6.6 fix applies: add declaration-only
Kconfig for memory_security and xpm and keep their source lines, so olddefconfig
does not silently drop CONFIG_SECURITY_XPM and flip the rest of the tree into
its #else branches; remove the obj-/subdir- lines that name directories which
do not exist; and remove only the three source lines whose files will never
exist.

Upstream: no equivalent; none of these files are part of Linux v5.15.
Licence: GPL-2.0-only, same as the tree.
---
 fs/Kconfig                      |  4 ----
 fs/proc/Makefile                |  1 -
 fs/proc/memory_security/Kconfig |  8 ++++++++
 security/Kconfig                |  1 -
 security/Makefile               |  3 ---
 security/xpm/Kconfig            | 16 ++++++++++++++++
 6 files changed, 24 insertions(+), 9 deletions(-)
 create mode 100644 fs/proc/memory_security/Kconfig
 create mode 100644 security/xpm/Kconfig

diff --git a/fs/Kconfig b/fs/Kconfig
index 82cda72..46345b7 100644
--- a/fs/Kconfig
+++ b/fs/Kconfig
@@ -116,10 +116,6 @@ config MANDATORY_FILE_LOCKING
 
 source "fs/crypto/Kconfig"
 
-source "fs/code_sign/Kconfig"
-
-source "fs/dec/Kconfig"
-
 source "fs/verity/Kconfig"
 
 source "fs/notify/Kconfig"
diff --git a/fs/proc/Makefile b/fs/proc/Makefile
index 8c53f3e..bcbca3e 100644
--- a/fs/proc/Makefile
+++ b/fs/proc/Makefile
@@ -35,4 +35,3 @@ proc-$(CONFIG_PRINTK)	+= kmsg.o
 proc-$(CONFIG_PROC_PAGE_MONITOR)	+= page.o
 proc-$(CONFIG_BOOT_CONFIG)	+= bootconfig.o
 proc-$(CONFIG_SECURITY_XPM)	+= xpm_region.o
-obj-$(CONFIG_MEMORY_SECURITY)	+= memory_security/
diff --git a/fs/proc/memory_security/Kconfig b/fs/proc/memory_security/Kconfig
new file mode 100644
index 0000000..6d9e0ad
--- /dev/null
+++ b/fs/proc/memory_security/Kconfig
@@ -0,0 +1,8 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Declared for configuration compatibility only.  This tree ships no
+# implementation of the memory_security subsystem, so enabling this option
+# builds nothing.  It exists so that board configurations which request
+# CONFIG_MEMORY_SECURITY=y keep validating.
+config MEMORY_SECURITY
+	bool
diff --git a/security/Kconfig b/security/Kconfig
index 3f6bf76..43cd1c1 100644
--- a/security/Kconfig
+++ b/security/Kconfig
@@ -231,7 +231,6 @@ source "security/yama/Kconfig"
 source "security/safesetid/Kconfig"
 source "security/lockdown/Kconfig"
 source "security/xpm/Kconfig"
-source "security/container_escape_detection/Kconfig"
 
 source "security/integrity/Kconfig"
 
diff --git a/security/Makefile b/security/Makefile
index 4042bbb..b34c1fb 100644
--- a/security/Makefile
+++ b/security/Makefile
@@ -14,7 +14,6 @@ subdir-$(CONFIG_SECURITY_SAFESETID)    += safesetid
 subdir-$(CONFIG_SECURITY_LOCKDOWN_LSM)	+= lockdown
 subdir-$(CONFIG_BPF_LSM)		+= bpf
 subdir-$(CONFIG_SECURITY_XPM)			+= xpm
-subdir-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection
 
 # always enable default capabilities
 obj-y					+= commoncap.o
@@ -34,8 +33,6 @@ obj-$(CONFIG_SECURITY_SAFESETID)       += safesetid/
 obj-$(CONFIG_SECURITY_LOCKDOWN_LSM)	+= lockdown/
 obj-$(CONFIG_CGROUPS)			+= device_cgroup.o
 obj-$(CONFIG_BPF_LSM)			+= bpf/
-obj-$(CONFIG_SECURITY_XPM)		+= xpm/
-obj-$(CONFIG_SECURITY_CONTAINER_ESCAPE_DETECTION) += container_escape_detection/
 
 # Object integrity file lists
 subdir-$(CONFIG_INTEGRITY)		+= integrity
diff --git a/security/xpm/Kconfig b/security/xpm/Kconfig
new file mode 100644
index 0000000..d93d87a
--- /dev/null
+++ b/security/xpm/Kconfig
@@ -0,0 +1,16 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Declared for configuration compatibility only.  kernel_linux_config sets
+# CONFIG_SECURITY_XPM in its base_defconfig, but this tree ships no
+# implementation of the xpm subsystem, so enabling the option builds nothing.
+# The obj- line in security/Makefile has been removed for that reason.  The
+# source line in security/Kconfig is deliberately kept: without it the symbol
+# would be unknown, olddefconfig would silently drop it, and the
+# CONFIG_SECURITY_XPM blocks elsewhere in the tree would take their #else
+# branches instead.
+config SECURITY_XPM
+	bool "OpenHarmony XPM (declared only; no implementation in this tree)"
+
+config SECURITY_XPM_DEBUG
+	bool "XPM debugging (declared only; no implementation in this tree)"
+	depends on SECURITY_XPM
-- 
2.39.5

